function Library.SetTheme(name)
	local preset = THEMES[name]
	if not preset then return false end
	currentTheme = name
	for k, v in pairs(preset) do C[k] = v end
	for i = #colorRegistry, 1, -1 do
		local e = colorRegistry[i]
		if e.obj and e.obj.Parent and C[e.key] then
			pcall(function() e.obj[e.prop] = C[e.key] end)
		else
			table.remove(colorRegistry, i)
		end
	end
	return true
end

function Library.SetStyle(name)
	local style = STYLES[name]
	if not style then return false end
	currentStyle = name
	currentRadius = style.radius
	return true
end

function Library.SetSize(index)
	if not SIZES[index] then return false end
	return true
end

function Library.GetTheme() return currentTheme, currentStyle end

