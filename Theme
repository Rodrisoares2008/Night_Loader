function Library.Toggle(parent, text, callback, tooltipText, options)
	options = options or {}
	local state = options.State == true
	local hasDescription = tooltipText and tooltipText ~= ""
	local bindValue = options.Bind
	local bindName = options.BindName or "--"
	local hasBind = options.AllowBind == true

	local f = New("Frame", {
		BackgroundColor3 = C.BgCard,
		BackgroundTransparency = 0,
		Size = UDim2.new(1, 0, 0, hasDescription and 46 or 44),
		ClipsDescendants = false,
		ColorKey = "BgCard",
	}, parent)
	Corner(currentRadius, f)
	local stroke = Stroke(C.Divider, 1, f)
	stroke.Transparency = 0.2
	trackColor(stroke, "Color", "Divider")
	Pad(0, 0, 16, hasBind and 118 or 18, f)

	New("TextLabel", {
		Text = text or "",
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.TxtWhite,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, hasBind and -124 or -78, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextColorKey = "TxtWhite",
	}, f)
	if hasDescription then
		New("TextLabel", {
			Text = tooltipText,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextColor3 = C.TxtDim,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 16, 0, 25),
			Size = UDim2.new(1, -32, 0, 16),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColorKey = "TxtDim",
		}, f)
	end

	local bindTag, gear
	if hasBind then
		bindTag = New("TextLabel", {
			BackgroundColor3 = C.BindBg,
			BorderSizePixel = 0,
			Position = UDim2.new(1, -76, 0.5, -10),
			Size = UDim2.new(0, 40, 0, 20),
			Font = Enum.Font.GothamBold,
			Text = bindName,
			TextColor3 = C.TxtWhite,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Center,
			ColorKey = "BindBg",
			TextColorKey = "TxtWhite",
		}, f)
		Corner(6, bindTag)
		gear = New("TextButton", {
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -34, 0.5, -14),
			Size = UDim2.new(0, 28, 0, 28),
			Text = utf8.char(0x2699),
			Font = Enum.Font.GothamBold,
			TextSize = 21,
			TextColor3 = C.TxtWhite,
			AutoButtonColor = false,
			TextColorKey = "TxtWhite",
		}, f)
		gear.MouseButton1Click:Connect(function()
			bindTag.Text = "..."
			local conn
			conn = UserInputService.InputBegan:Connect(function(input)
				if input.KeyCode == Enum.KeyCode.Escape then
					bindValue = nil; bindName = "--"
				else
					bindValue = input.KeyCode
					bindName = input.KeyCode.Name
				end
				bindTag.Text = bindName
				conn:Disconnect()
				if options.onBindChange then pcall(options.onBindChange, bindValue, bindName) end
			end)
		end)
	end

	local track = New("Frame", {
		BackgroundColor3 = state and C.ToggleOn or C.ToggleOff,
		BorderSizePixel = 0,
		Position = hasBind and UDim2.new(1, -118, 0.5, -11) or UDim2.new(1, -54, 0.5, -11),
		Size = UDim2.new(0, 40, 0, 22),
		ColorKey = state and "ToggleOn" or "ToggleOff",
	}, f)
	Corner(11, track)
	local trackStroke = Stroke(state and C.Accent or C.Divider, 1, track)
	trackStroke.Transparency = 0.2
	local circle = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Position = state and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
		Size = UDim2.new(0, 16, 0, 16),
	}, track)
	Corner(8, circle)

	local function applyVisuals()
		track.BackgroundColor3 = state and C.ToggleOn or C.ToggleOff
		trackStroke.Color = state and C.Accent or C.Divider
		UI_Tween(circle, { Position = state and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }, 0.2)
	end

	local api = {}
	function api.Get() return state end
	function api.Set(newState, invokeCallback)
		state = newState and true or false
		applyVisuals()
		if invokeCallback ~= false and callback then pcall(callback, state) end
	end
	function api.Toggle() api.Set(not state) end
	function api.GetBind() return bindValue, bindName end

	local btn = New("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 1, 0),
	}, f)
	btn.MouseButton1Click:Connect(function() api.Toggle() end)
	applyVisuals()
	return setmetatable(api, { __index = f })
end

function Library.Slider(parent, labelText, minValue, maxValue, callback, opts)
	opts = opts or {}
	minValue = minValue or 0
	maxValue = maxValue or 100
	local value = opts.Value or minValue
	local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38) }, parent)
	local lbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.55, 0, 0, 18),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = C.TxtWhite,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = tostring(labelText or "") .. ": " .. tostring(math.floor(value)),
		TextColorKey = "TxtWhite",
	}, holder)
	local track = New("Frame", {
		BackgroundColor3 = C.SliderBg,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 10),
		ColorKey = "SliderBg",
	}, holder)
	Corner(5, track)
	local trackStroke = Stroke(C.Divider, 1, track)
	trackStroke.Transparency = 0.6
	local fill = New("Frame", {
		BackgroundColor3 = C.Purple,
		BorderSizePixel = 0,
		Size = UDim2.fromScale((value - minValue) / (maxValue - minValue), 1),
		ColorKey = "Purple",
	}, track)
	Corner(5, fill)
	local function apply(v)
		value = math.clamp(v, minValue, maxValue)
		fill.Size = UDim2.fromScale((value - minValue) / (maxValue - minValue), 1)
		lbl.Text = tostring(labelText or "") .. ": " .. tostring(math.floor(value))
		if callback then pcall(callback, value) end
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local sp, ss = track.AbsolutePosition, track.AbsoluteSize
		if ss.X <= 0 then return end
		local rel = math.clamp((UserInputService:GetMouseLocation().X - sp.X) / ss.X, 0, 1)
		apply(minValue + rel * (maxValue - minValue))
	end)
	local api = {}
	function api.Get() return value end
	function api.Set(v) apply(v) end
	return setmetatable(api, { __index = holder })
end

function Library.TabBar(parent, names, onChange)
	local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34) }, parent)
	local layout = ListLayout(8, holder)
	layout.FillDirection = Enum.FillDirection.Horizontal
	local buttons = {}
	local active = nil
	local count = #names
	for i, name in ipairs(names) do
		local btn = New("TextButton", {
			BackgroundColor3 = C.BgInput,
			BackgroundTransparency = 0.05,
			BorderSizePixel = 0,
			Size = UDim2.new(1 / count, -4, 1, 0),
			Text = name,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextColor3 = C.TxtWhite,
			AutoButtonColor = false,
			ColorKey = "BgInput",
			TextColorKey = "TxtWhite",
		}, holder)
		Corner(6, btn)
		Stroke(C.Divider, 1, btn).Transparency = 0.25
		btn.MouseButton1Click:Connect(function()
			for _, other in pairs(buttons) do
				other.BackgroundColor3 = C.BgInput
				other.BackgroundTransparency = 0.05
			end
			btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
			btn.BackgroundTransparency = 0.85
			active = name
			if onChange then pcall(onChange, name) end
		end)
		buttons[name] = btn
	end
	if names[1] then
		buttons[names[1]].BackgroundColor3 = Color3.fromRGB(35, 35, 42)
		buttons[names[1]].BackgroundTransparency = 0.85
		active = names[1]
	end
	local api = {}
	function api.Get() return active end
	function api.Set(name)
		local btn = buttons[name]
		if btn then btn.MouseButton1Click:Fire() end
	end
	return setmetatable(api, { __index = holder })
end

local toastHolder = nil
local function ensureToastHolder(gui)
	if toastHolder and toastHolder.Parent then return toastHolder end
	toastHolder = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -24, 0, 24),
		Size = UDim2.new(0, 320, 1, -48),
		ZIndex = 10000040,
	}, gui or LocalPlayer:FindFirstChildOfClass("PlayerGui"))
	toastHolder.AnchorPoint = Vector2.new(1, 0)
	local l = ListLayout(10, toastHolder)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	return toastHolder
end

function Library.Toast(titleText, bodyText, accentColor, gui)
	local holder = ensureToastHolder(gui)
	local toast = New("Frame", {
		BackgroundColor3 = C.BgCard,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundTransparency = 1,
		ZIndex = 10000041,
		ColorKey = "BgCard",
	}, holder)
	Corner(10, toast)
	local stroke = Stroke(accentColor or C.Purple, 1, toast)
	stroke.Transparency = 0.2
	New("Frame", {
		BackgroundColor3 = accentColor or C.Purple,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 1, 0),
		ZIndex = 10000042,
	}, toast)
	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 8),
		Size = UDim2.new(1, -22, 0, 18),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = C.TxtWhite,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = titleText or "Night UI",
		ZIndex = 10000042,
		TextColorKey = "TxtWhite",
	}, toast)
	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 28),
		Size = UDim2.new(1, -22, 0, 24),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = C.TxtWhite,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = bodyText or "",
		ZIndex = 10000042,
		TextColorKey = "TxtWhite",
	}, toast)
	UI_Tween(toast, { BackgroundTransparency = 0.04 }, 0.18)
	task.delay(3.2, function()
		if toast and toast.Parent then
			UI_Tween(toast, { BackgroundTransparency = 1 }, 0.18)
			task.delay(0.22, function()
				if toast and toast.Parent then pcall(function() toast:Destroy() end) end
			end)
		end
	end)
	return toast
end
Library.Notify = Library.Toast

return Library
